# Copy this file to .env for local backend development, then fill in values for your environment.

# MongoDB connection used by Nest/Mongoose and seed scripts.
MONGODB_URI=mongodb://localhost:27017/flexee

# JWT signing. Use a long random secret outside local development.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=24h

# API runtime settings.
PORT=3001
GLOBAL_PREFIX=api
NODE_ENV=development

# Frontend origin used for invite links and seed output.
FRONTEND_URL=http://localhost:3000

# Mailjet email delivery. Leave blank for local development without email.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=FLEXEE DA

# The deployed commit, reported by GET /api/health and the reporting
# connector. Set it on every deploy (for example to the output of
# `git rev-parse --short HEAD`), then restart. On Vercel this can stay
# blank: Vercel's own VERCEL_GIT_COMMIT_SHA is used instead.
GIT_COMMIT=

# Turns on GET /api/cron/quarter-tick, which closes quarters past their
# deadline and sends the day-before reminders. Vercel's cron sends this
# value as a bearer token automatically. Use a long random string. When
# blank, the endpoint refuses every call.
CRON_SECRET=

# The API's public address, used in the reporting connector's OAuth metadata
# (for example https://api.example.com, no /api). Without it, the address a
# request came in on is used. FRONTEND_URL above is where admins approve.
PUBLIC_API_URL=

# AI features (V3 layer 4). AI runs only when FLEXEE_LLM_PROVIDER=anthropic and
# ANTHROPIC_API_KEY are both set. Every call is logged; once this calendar
# month's spend (UTC) reaches the ceiling, every AI feature stops until the
# month turns over. Prices are US dollars per million tokens for the model.
FLEXEE_LLM_PROVIDER=
ANTHROPIC_API_KEY=
FLEXEE_LLM_MODEL=claude-haiku-4-5
FLEXEE_AI_MONTHLY_CEILING_USD=50
FLEXEE_LLM_INPUT_USD_PER_MTOK=1
FLEXEE_LLM_OUTPUT_USD_PER_MTOK=5

# Ask Claude for faculty (V3 Design C). Uses the same site switch as above,
# with its own model and prices. Defaults: claude-sonnet-5-5, 4000 tokens,
# $2 in / $10 out per million tokens, 100 questions per course per month.
FLEXEE_ASK_MODEL=
FLEXEE_ASK_MAX_TOKENS=
FLEXEE_ASK_INPUT_USD_PER_MTOK=
FLEXEE_ASK_OUTPUT_USD_PER_MTOK=
FLEXEE_ASK_QUESTIONS_PER_MONTH=

# Seeder (never runs when NODE_ENV=production). Set these to have `npm run seed`
# create admin@flexee.com and faculty1@flexee.com; unset, it skips them. An
# account that already exists keeps its password.
SEED_ADMIN_PASSWORD=
SEED_FACULTY_PASSWORD=
